{
  "expo": {
    "name": "Appigeek",
    "slug": "appy-geek",
    "version": "1.0.24",
    "scheme": "appigeek",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0e14"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.appigeek.reader",
      "buildNumber": "52",
      "appleTeamId": "2QKC854C2J",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appigeek.reader",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0e14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-scene-lifecycle",
      "./plugins/with-ios-deployment-target",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "en",
              "es",
              "it",
              "pt"
            ],
            "android": [
              "fr",
              "en",
              "es",
              "it",
              "pt"
            ]
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5892183761290562~9981862026",
          "iosAppId": "ca-app-pub-5892183761290562~9981862026"
        }
      ],
      "expo-secure-store",
      "expo-quick-actions",
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "7efd1549-548c-45a9-aede-4603bb6efab0"
      },
      "supabaseUrl": "https://ppnejmwvmkqnmrzcivqs.supabase.co",
