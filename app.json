{
  "expo": {
    "name": "Appigeek",
    "slug": "appy-geek",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0e14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appigeek.reader",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appigeek.reader",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0e14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5892183761290562~9981862026",
          "iosAppId": "ca-app-pub-5892183761290562~9981862026"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7efd1549-548c-45a9-aede-4603bb6efab0"
      }
    },
    "owner": "dorian172"
  }
}
